PORT=5050
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin security
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_random_admin_password
ADMIN_SESSION_SECRET=replace_with_a_long_random_session_secret
ADMIN_SESSION_TTL_MS=43200000

# Splunk HTTP Event Collector
SPLUNK_HEC_URL=https://localhost:8088/services/collector/event
SPLUNK_HEC_TOKEN=replace_with_your_hec_token
SPLUNK_INDEX=main
ALLOW_INSECURE_TLS=false

# Splunk Search API
SPLUNK_SEARCH_URL=https://localhost:8089
SPLUNK_USERNAME=replace_with_splunk_username
SPLUNK_PASSWORD=replace_with_splunk_password

# Allowed official data hosts for admin import
OFFICIAL_DATA_ALLOWED_HOSTS=gco.iarc.who.int,ecis.jrc.ec.europa.eu,ghoapi.azureedge.net,who.int,www.who.int
OFFICIAL_CANCER_DATA_URL=
OFFICIAL_CANCER_DATA_NAME=Configured Official Cancer Dataset
OFFICIAL_CANCER_SOURCE_NAME=verified_official_source

# OpenRouter
OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=OncoConnect AI
